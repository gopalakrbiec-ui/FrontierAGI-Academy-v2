---
const { path, count = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<article class={`path-card path-${path.color}`}>
  <div class="path-icon" aria-hidden="true">{path.icon}</div>
  <p class="eyebrow">{path.level}</p>
  <h3>{path.title}</h3>
  <p>{path.description}</p>
  <div class="path-meta"><span>{count} lessons</span><a href={`${base}library/?path=${path.id}`}>Explore path <span aria-hidden="true">→</span></a></div>
</article>
